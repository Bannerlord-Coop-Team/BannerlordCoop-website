{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bannerlordcoop-website",
  "keep_vars": true,
  "vars": {
    "ADMIN_IMPERSONATION_ENABLED": "true",
    // Server-only base URL of the nightly-gateway Edge Function used by /nightly/*. Its shared
    // secret NIGHTLY_WEBSITE_KEY is a Worker secret: `npx wrangler secret put NIGHTLY_WEBSITE_KEY`.
    "NIGHTLY_FUNCTION_URL": "https://wfvqnijwuyqjibhlcrhz.supabase.co/functions/v1/nightly-gateway"
  },
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bannerlordcoop-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
