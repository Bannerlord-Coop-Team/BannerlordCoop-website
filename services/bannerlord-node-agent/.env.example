# Persistent outbound WSS endpoint exposed by the console gateway.
CONSOLE_GATEWAY_NODE_URL=wss://console.example.com/v1/node
CONSOLE_NODE_TOKEN=replace_with_the_same_long_random_secret
CONSOLE_NODE_ID=vps-15-204-120-17

# Shared defaults used when a server entry does not override them.
BANNERLORD_UPDATE_IMAGE=ghcr.io/bannerlord-coop-team/bannerlord-coop-dedicated-server:latest
BANNERLORD_READY_LOG_PATTERN='"phase":"serving"'
BANNERLORD_DATA_PATH=/srv/data

# Preferred strict allowlist. Every server needs a unique stable container name,
# named volume, and host UDP port. dataPath, updateImage, and readinessPattern
# may be overridden inside an individual server object.
AGENT_SERVERS={"bannerlord-live-one":{"container":"bannerlord-one","dataVolume":"bannerlord-one-data","udpPort":4200},"bannerlord-live-two":{"container":"bannerlord-two","dataVolume":"bannerlord-two-data","udpPort":4201}}

# Legacy single-server configuration remains supported when AGENT_SERVERS is unset.
# BANNERLORD_CONTAINER=bannerlordcoop
# BANNERLORD_DATA_VOLUME=bannerlordcoop-data
# BANNERLORD_UDP_PORT=4200
# The older AGENT_SERVER_CONTAINERS/AGENT_SERVER_UPDATE_IMAGES mappings are also
# parsed, but multi-server deployments must migrate to AGENT_SERVERS so each
# entry can declare a unique volume and UDP port.

DOCKER_SOCKET=/var/run/docker.sock
CONSOLE_TAIL_LINES=500
CONTAINER_STOP_TIMEOUT_SECONDS=60
CONTAINER_UPDATE_READINESS_TIMEOUT_SECONDS=300

# Local development only. Production must use wss://.
# ALLOW_INSECURE_CONSOLE_GATEWAY=true
