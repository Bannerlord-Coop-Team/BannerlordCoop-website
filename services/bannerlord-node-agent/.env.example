# Persistent outbound WSS endpoint exposed by the console gateway.
CONSOLE_GATEWAY_NODE_URL=wss://console.example.com/v1/node
CONSOLE_NODE_TOKEN=replace_with_the_same_long_random_secret
CONSOLE_NODE_ID=vps-15-204-120-17

# Exact, stable Docker container name for the fixed website server ID. IDs are rejected.
BANNERLORD_CONTAINER=bannerlord-server
# Image pulled by the Admin Update operation. An unchanged digest is a no-op.
BANNERLORD_UPDATE_IMAGE=ghcr.io/bannerlord-coop-team/bannerlord-coop-dedicated-server:latest
# Or configure multiple explicit mappings instead:
# AGENT_SERVER_CONTAINERS={"bannerlord-live-15-204-120-17":"bannerlord-server"}
# AGENT_SERVER_UPDATE_IMAGES={"bannerlord-live-15-204-120-17":"ghcr.io/example/server:latest"}

DOCKER_SOCKET=/var/run/docker.sock
CONSOLE_TAIL_LINES=500
CONTAINER_STOP_TIMEOUT_SECONDS=60
CONTAINER_UPDATE_READINESS_TIMEOUT_SECONDS=300
BANNERLORD_READY_LOG_PATTERN='"phase":"serving"'
BANNERLORD_DATA_VOLUME=bannerlordcoop-data
BANNERLORD_DATA_PATH=/srv/data
BANNERLORD_UDP_PORT=4200

# Local development only. Production must use wss://.
# ALLOW_INSECURE_CONSOLE_GATEWAY=true
