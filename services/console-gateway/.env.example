PORT=8787

# Exact browser origins permitted to open the Admin console WebSocket.
CONSOLE_ALLOWED_ORIGINS=https://www.example.com,http://localhost:3000

# Existing Supabase project; the gateway uses Auth getUser() for every new session.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_ADMIN_EMAILS=owner@example.com

# Same random value on the gateway and node agent (at least 32 characters).
CONSOLE_NODE_TOKEN=replace_with_a_long_random_secret

# Explicit server-to-node allowlist. Multiple server IDs may target one VPS node.
CONSOLE_SERVER_NODES={"bannerlord-live-one":"vps-primary","bannerlord-live-two":"vps-primary"}

# Optional bounded session/authentication and abuse limits.
CONSOLE_AUTH_TIMEOUT_MS=10000
CONSOLE_SESSION_MAX_MS=600000
CONSOLE_OPERATION_TIMEOUT_MS=900000
CONSOLE_MAX_BROWSER_CONNECTIONS=100
CONSOLE_MAX_CONCURRENT_AUTHS=10
CONSOLE_MAX_UPGRADES_PER_MINUTE=30

# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
# CONSOLE_TRUST_PROXY=true
