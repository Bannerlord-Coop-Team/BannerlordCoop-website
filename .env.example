# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional server-only control-plane origin for direct admin/owner/public API reads.
# Unset or empty uses https://control-plane.bannerlordcoop.com. Must be a bare https:// origin
# (no credentials, path, query or fragment); an invalid value fails every direct read closed.
# CONTROL_PLANE_ORIGIN=https://localhost:9443

# Fixed server-only Oracle control-plane origin for managed read-only console SSE
CONTROL_PLANE_CONSOLE_ORIGIN=https://control-plane.example.com

# Server-only Supabase secret key used by member administration
SUPABASE_SECRET_KEY=your_secret_key

# Enable only after every active service validates impersonation sessions.
ADMIN_IMPERSONATION_ENABLED=false

# Comma-separated emails that always retain bootstrap admin access
SUPABASE_ADMIN_EMAILS=owner@example.com

# Optional local debug sign-in: visit /auth/dev-login?next=/servers to sign in as this
# existing account without OAuth. Only works under `next dev` on localhost.
# DEV_AUTH_EMAIL=you@example.com

# Optional: enables live YouTube metadata on the home page
YOUTUBE_API_KEY=your_youtube_api_key
