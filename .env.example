# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase secret key used by member and live-server access management
SUPABASE_SECRET_KEY=your_secret_key

# Comma-separated emails that always retain bootstrap admin access
SUPABASE_ADMIN_EMAILS=owner@example.com

# Public HTTPS origin of the Oracle control-plane web-admin adapter. The
# website forwards only an authenticated Supabase administrator session.
CONTROL_PLANE_ADMIN_URL=https://control.example.com

# IONOS Cloud API token (server-only; the secret is used as the bearer token)
IONOS_TOKEN_ID=your_token_id
IONOS_CLOUD_API_TOKEN=your_full_jwt_token

# IONOS management is hidden and billable server creation is rejected unless explicitly enabled
IONOS_MANAGEMENT_ENABLED=false
IONOS_SERVER_CREATION_ENABLED=false

# Optional IONOS Cube provisioning defaults (used only when IONOS management is enabled)
IONOS_LOCATION=de/fra/2
IONOS_IMAGE_ALIAS=ubuntu:24.04

# Protected external Docker console (server-only; include /v1/browser)
CONSOLE_GATEWAY_URL=wss://console.example.com/v1/browser
# Optional catalog override. Multiple entries may point at the same node/VPS.
CONSOLE_SERVER_CATALOG=[{"id":"bannerlord-live-one","name":"Bannerlord Server One","address":"203.0.113.10:4200","nodeId":"vps-primary","provider":"External VPS"},{"id":"bannerlord-live-two","name":"Bannerlord Server Two","address":"203.0.113.10:4201","nodeId":"vps-primary","provider":"External VPS"}]

# Optional: enables live YouTube metadata on the home page
YOUTUBE_API_KEY=your_youtube_api_key
