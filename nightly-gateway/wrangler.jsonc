{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bannerlordcoop-nightly-gateway",
  "account_id": "734149e144bd731947b01477afb5898d",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "nightly.bannerlordcoop.com", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "LEGACY_R2_ORIGIN": "https://pub-bf6bfe4b880e4d1b83f4b09b10419f78.r2.dev",
    "NIGHTLY_FUNCTION_URL": "https://wfvqnijwuyqjibhlcrhz.supabase.co/functions/v1/nightly-gateway"
  },
  "r2_buckets": [
    { "binding": "PUBLIC_RELEASES", "bucket_name": "bannerlordcoop-nightly-releases" },
    { "binding": "RELEASES", "bucket_name": "bannerlordcoop-patron-nightlies" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0ae7d7f7e45a4261b380e01b3ed9b225"
    }
  ]
}
