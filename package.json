{
  "name": "bannerlordcoop-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "test": "tsx --test src/app/lib/auth/redirect.test.ts src/app/lib/auth/roles.test.ts src/app/lib/hosting/servers.test.ts nightly-gateway/src/core.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gateway:types": "wrangler types --config nightly-gateway/wrangler.jsonc nightly-gateway/worker-configuration.d.ts",
    "gateway:check": "tsc --project nightly-gateway/tsconfig.json",
    "gateway:dry-run": "npm run gateway:sync-installer && wrangler deploy --dry-run --config nightly-gateway/wrangler.jsonc",
    "gateway:sync-installer": "node --input-type=module -e \"import{copyFileSync}from'node:fs';copyFileSync('public/server/install.ps1','nightly-gateway/public/install.ps1')\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.40.2"
  }
}
